# Pervez Furniture — environment variables
#
# Business details (WhatsApp number, address, opening hours, social links)
# live in src/config/site.ts.

# Option 1 Admin Session Authentication (Showroom Products Catalogue Manager: /admin)
ADMIN_EMAIL=admin@pervezfurniture.pk
ADMIN_PASSWORD=PervezAdmin2026!

# Option 1 Private SuperAdmin Authentication (WhatsApp Leads & R2 Settings: /superadmin)
SUPERADMIN_EMAIL=owner@pervezfurniture.pk
SUPERADMIN_PASSWORD=SuperAdmin2026!

SESSION_SECRET=replace-with-a-random-32-byte-hmac-secret-in-production

# Cloudflare R2 Media Storage (Optional — falls back to edge/local media handler in dev)
R2_PUBLIC_URL=https://media.pervezfurniture.example
